dist/
*.zip

# Local secrets for manual sends (Discord webhook URL). Never committed.
.env.local

# OpenTofu / Terraform
# The provider lock file is committed on purpose — it pins what actually applied.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
# terraform.tfvars is committed: it holds only league IDs (public, they're in
# the FPL URL), channel names and SSM parameter *names*. The webhook URLs stay
# in SSM. Any other tfvars file is still ignored.
infra/*.tfvars
!infra/terraform.tfvars
crash.log
