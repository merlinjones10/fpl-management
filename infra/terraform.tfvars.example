# Copy to terraform.tfvars and fill in. That file is gitignored.

# One Lambda serves every league here. Each gets its own DynamoDB partition and
# its own sender, so they can sit on different channels — or share one.
#
# Store each webhook URL yourself, so it never enters Terraform state:
#   aws ssm put-parameter --name /fpl-league-bot/a-discord \
#     --type SecureString --value '<WEBHOOK URL>'
#
# Discord: Server Settings > Integrations > Webhooks > New Webhook.
#   Copy a message out with the message menu's "Copy Text" — that returns the
#   raw source, so *bold* survives the paste into WhatsApp. Dragging a selection
#   does not: Discord copies the rendered text and drops the markup.
# Slack:   api.slack.com/apps > Incoming Webhooks > Add New Webhook to Workspace.
leagues = {
  a = {
    id            = 1058423
    channel       = "discord"
    webhook_param = "/fpl-league-bot/discord-webhook"
  }

  # A second league can point at the same webhook until it has its own — both
  # digests then land in that one channel, each headed by its league name.
  # b = {
  #   id            = 2222222
  #   channel       = "discord"
  #   webhook_param = "/fpl-league-bot/discord-webhook"
  # }

  # …and moves to its own channel by editing these two lines and re-applying.
  # c = {
  #   id            = 3333333
  #   channel       = "slack"
  #   webhook_param = "/fpl-league-bot/c-slack"
  # }
}

# --- Optional -------------------------------------------------------------
# reminder_lead_hours = 48
# schedule_expression = "cron(0 9,21 * * ? *)"   # 09:00 and 21:00, in var.timezone
